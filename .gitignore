# ─────────────────────────────────────────────
#  Pendientes · archivos que NO van al repositorio
# ─────────────────────────────────────────────

# Python
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Django
db.sqlite3
*.sqlite3
*.sqlite3-journal
staticfiles/
media/

# Migraciones (se generan con: python manage.py makemigrations)
# Nota: se conserva __init__.py para que Django reconozca el paquete.
aplications/*/migrations/*
!aplications/*/migrations/__init__.py

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Editores y sistema operativo
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/
